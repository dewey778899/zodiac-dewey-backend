# 复制此文件为 .env 并填入真实值
# 切勿将 .env 提交到 Git 仓库

# ===== AI API Keys =====
DEEPSEEK_API_KEY=***
CLAUDE_API_KEY=***
ADMIN_PASSWORD=your-a...word

# ===== Payment Common =====
# 支付金额（单位：分，2990 = 29.90 元）
PAY_AMOUNT_FEN=2990
# 订单过期时间（分钟）
PAY_ORDER_EXPIRE_MINUTES=30
# 开发模拟模式（正式环境设为 false）
PAY_DEV_MOCK_ENABLED=true

# ===== WeChat Pay（微信支付）=====
# 是否启用（false=开发模拟模式）
WECHAT_PAY_ENABLED=false
# 商户号
WECHAT_PAY_MCH_ID=
# 商户 API v3 密钥
WECHAT_PAY_API_V3_KEY=
# 商户证书序列号
WECHAT_PAY_MCH_SERIAL_NO=
# 商户私钥文件路径（PEM 格式）
WECHAT_PAY_PRIVATE_KEY_PATH=
# 平台证书文件路径
WECHAT_PAY_PLATFORM_CERT_PATH=
# 支付结果回调地址（需公网可访问）
WECHAT_PAY_NOTIFY_URL=
# H5 支付跳转地址
WECHAT_PAY_H5_RETURN_URL=
# 公众账号 AppID（小程序/公众号）
WECHAT_PAY_APP_ID=
# 公众账号 AppSecret（用于获取 openid）
WECHAT_PAY_APP_SECRET=

# ===== Alipay（支付宝）=====
# 是否启用
ALIPAY_ENABLED=false
# 应用 AppID
ALIPAY_APP_ID=
# 应用私钥文件路径（PEM 格式）
ALIPAY_PRIVATE_KEY_PATH=
# 支付宝公钥
ALIPAY_PUBLIC_KEY=
# 支付结果回调地址
ALIPAY_NOTIFY_URL=
# 支付完成跳转地址
ALIPAY_RETURN_URL=
# 签名方式（RSA2 或 RSA）
ALIPAY_SIGN_TYPE=RSA2
