# 复制此文件为 .env 并填入真实值
# 切勿将 .env 提交到 Git 仓库

DEEPSEEK_API_KEY=sk-your-deepseek-key
CLAUDE_API_KEY=sk-your-claude-key
ADMIN_PASSWORD=your-admin-password

# Payment common
PAY_AMOUNT_FEN=1
PAY_DEV_MOCK_ENABLED=true

# WeChat Pay
WECHAT_PAY_ENABLED=false
WECHAT_PAY_MCH_ID=1114131461
WECHAT_PAY_APP_ID=wxa5b577bf1013eb14
WECHAT_PAY_APP_SECRET=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_MCH_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY_PATH=/app/certs/apiclient_key.pem
WECHAT_PAY_CLIENT_CERT_PATH=/app/certs/apiclient_cert.pem
WECHAT_PAY_PLATFORM_CERT_PATH=
WECHAT_PAY_NOTIFY_URL=https://zodiac.xiaodengge.top/api/pay/notify/wechat
WECHAT_PAY_H5_RETURN_URL=https://zodiac.xiaodengge.top/?payReturn=1
WECHAT_OAUTH_REDIRECT_URL=

# Alipay
ALIPAY_ENABLED=false
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY_PATH=
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=https://zodiac.xiaodengge.top/api/pay/notify/alipay
ALIPAY_RETURN_URL=https://zodiac.xiaodengge.top/?payReturn=1
ALIPAY_SIGN_TYPE=RSA2
